# npm ignores .gitignore entirely when this file exists.
# Mirrors .gitignore, minus the build artifacts that are git-ignored but MUST
# ship: src/parser/c.lang.ts, src/library/library.ts, ide/js/version.js.
# Consumers import from src/, so those generated sources are part of the package.
