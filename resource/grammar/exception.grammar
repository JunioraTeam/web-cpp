TryBlock
    = 'try' !IdentifierPart _ body:CompoundStatement _ handlers:HandlerSeq {
        return new AST.TryBlock(getLocation(), body, handlers);
    }

HandlerSeq
    = head:ExceptionHandler tail:(_ ExceptionHandler)* {
        return buildList(head, tail, 1);
    }

ExceptionHandler
    = 'catch' !IdentifierPart _ '(' _ '...' _ ')' _ body:CompoundStatement {
        return new AST.ExceptionHandler(getLocation(), null, body);
    }
    / 'catch' !IdentifierPart _ '(' _ decl:ParameterDeclaration _ &!')' _ body:CompoundStatement {
        return new AST.ExceptionHandler(getLocation(), decl, body);
    }
